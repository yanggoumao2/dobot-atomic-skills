# Store text as LF in the repo and check it out as LF, so Windows editors that
# save CRLF no longer show files as modified.
* text=auto eol=lf

# Windows launchers keep CRLF in the working tree.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.npz binary
*.npy binary
